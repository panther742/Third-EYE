{
  "name": "third-eye",
  "private": true,
  "version": "0.1.1",
  "description": "Third Eye \u2014 real-time eye on planet Earth. Live aircraft, satellites, earthquakes, traffic, public cameras on a photorealistic globe. India-first, Surat-born.",
  "type": "module",
  "license": "MIT",
  "author": "Bilawal Sidhu",
  "repository": {
    "type": "git",
    "url": "https://github.com/panther742/Third-EYE.git"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "keywords": [
    "third-eye",
    "live-globe",
    "cesium",
    "flight-tracking",
    "osint",
    "india",
    "surat",
    "real-time",
    "satellite-tracking",
    "traffic"
  ],
  "scripts": {
    "doctor": "node scripts/setup-doctor.mjs",
