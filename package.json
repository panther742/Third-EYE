    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "^1.124.0",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "puppeteer": "^24.37.5",
    "sharp": "^0.34.5",
    "vite": "^6.0.0",
